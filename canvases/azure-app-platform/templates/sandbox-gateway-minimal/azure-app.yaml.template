name: __APP_SLUG__
purpose: "__PURPOSE_JSON__"
capabilities:
  agent:
    path: src/agent
    # Default only; scripts and Studio apply .azure-app-platform/ports.env when saved.
    interface: http://localhost:8088
    links: [sandbox, gateway]
  sandbox:
    path: src/tools/document-validation
    # ACA_SANDBOX_GROUP selects microVMs; otherwise a local process, not OS isolation.
    interface: subprocess
    links: [agent]
  gateway:
    path: infra-ai-gateway
    interface: configuration
    links: [agent]
