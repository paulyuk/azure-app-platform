$ErrorActionPreference = "SilentlyContinue"
$Root = Split-Path -Parent $PSScriptRoot
$RunDir = Join-Path $Root ".dev-run"
$ProcessFile = Join-Path $RunDir "processes.json"

if (Test-Path $ProcessFile) {
  $records = Get-Content -Path $ProcessFile -Raw | ConvertFrom-Json
  foreach ($record in @($records)) {
    $pidValue = if ($record.pid) { [int]$record.pid } elseif ($record.Pid) { [int]$record.Pid } else { 0 }
    if ($pidValue -gt 0 -and (Get-Process -Id $pidValue -ErrorAction SilentlyContinue)) {
      if (Get-Command taskkill.exe -ErrorAction SilentlyContinue) {
        & taskkill.exe /PID $pidValue /T /F | Out-Null
      } else {
        Stop-Process -Id $pidValue -Force
      }
    }
  }
}
Remove-Item -Path $RunDir -Recurse -Force

