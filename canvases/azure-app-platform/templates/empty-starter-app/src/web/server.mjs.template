[data-theme="dark"]{
  --bg:#12131a;--bg-soft:#0d0e14;--bg-elev:#161722;--surface-muted:#232533;--border:#2e3042;--border-strong:#3e4158;
  --text:#f5f6fa;--text-muted:#c7c9d9;--accent:#7b83eb;--accent-strong:#626ae3;--accent-soft:#252849;--accent-contrast:#ffffff;
  --shadow-2:0 0 0 1px rgba(255,255,255,0.06),0 12px 28px rgba(0,0,0,0.45);
}
[data-style="warm"][data-theme="dark"]{
  --bg:#181310;--bg-soft:#120e0c;--bg-elev:#1d1612;--surface-muted:#29201a;--border:#3d2f28;--border-strong:#544037;
  --text:#faf5f0;--text-muted:#d6c7b8;--accent:#fb923c;--accent-strong:#f97316;--accent-soft:#3b2110;--accent-contrast:#181310;
}
[data-style="modern"][data-theme="dark"]{
  --bg:#0b111e;--bg-soft:#070b14;--bg-elev:#111a2e;--surface-muted:#1a2640;--border:#263554;--border-strong:#364970;
  --text:#f1f5f9;--text-muted:#cbd5e1;--accent:#38bdf8;--accent-strong:#0ea5e9;--accent-soft:#102a45;--accent-contrast:#08101d;
}
[data-style="editorial"][data-theme="dark"]{
  --bg:#171513;--bg-soft:#12100e;--bg-elev:#1b1815;--surface-muted:#2b2723;--border:#3d3731;--border-strong:#524a42;
  --text:#f5f2eb;--text-muted:#d4cdc3;--accent:#f59e0b;--accent-strong:#d97706;--accent-soft:#382012;--accent-contrast:#171513;
}
[data-style="minimal"][data-theme="dark"]{
  --bg:#09090b;--bg-soft:#050506;--bg-elev:#121215;--surface-muted:#1c1c21;--border:#e4e4e7;--border-strong:#fafafa;
  --text:#fafafa;--text-muted:#d4d4d8;--accent:#fafafa;--accent-strong:#e4e4e7;--accent-soft:#27272a;--accent-contrast:#09090b;
  --shadow-2:4px 4px 0 0 #e4e4e7;
}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;padding:48px 20px;background:var(--bg-soft);color:var(--text);font:14px/1.5 var(--font-sans);-webkit-font-smoothing:antialiased}
main{max-width:720px;margin:0 auto;background:var(--bg-elev);border:1px solid var(--border);border-radius:var(--radius-2xl);box-shadow:var(--shadow-2);padding:32px}
h1{margin:0 0 8px;font:600 24px/1.25 var(--font-display);letter-spacing:-0.02em}
p{margin:0 0 20px;color:var(--text-muted)}
textarea{width:100%;min-height:96px;padding:12px 14px;margin-top:8px;border:1px solid var(--border-strong);border-radius:var(--radius-lg);background:var(--bg);color:var(--text);font:inherit;resize:vertical}
textarea:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:transparent}
#send{width:100%;padding:10px 16px;margin-top:12px;border:none;border-radius:var(--radius-md);background:var(--accent);color:var(--accent-contrast);font:600 14px/1.4 var(--font-sans);cursor:pointer}
#send:hover{background:var(--accent-strong)}
pre{white-space:pre-wrap;background:var(--surface-muted);border:1px solid var(--border);color:var(--text);padding:16px;border-radius:var(--radius-lg);font:12px/1.5 var(--font-mono);margin:16px 0 0}
</style></head><body><main>
<h1>${appNameHtml}</h1><p>${purposeHtml}</p>
<textarea id="message" placeholder="Try the local agent boundary"></textarea>
<button id="send">Send</button><pre id="result">Ready.</pre>
</main><script>
send.onclick=async()=>{result.textContent="Working…";const response=await fetch("/api/chat",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({message:message.value})});result.textContent=JSON.stringify(await response.json(),null,2)}
</script></body></html>`;

createServer(async (request, response) => {
  if (request.method === "POST" && request.url === "/api/chat") {
    const chunks = [];
    for await (const chunk of request) chunks.push(chunk);
    const agent = await fetch(agentUrl + "/responses", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: Buffer.concat(chunks),
    });
    response.writeHead(agent.status, { "content-type": "application/json" });
    response.end(await agent.text());
    return;
  }
  response.writeHead(200, { "content-type": "text/html; charset=utf-8" });
  response.end(page);
}).listen(webPort, "127.0.0.1");
