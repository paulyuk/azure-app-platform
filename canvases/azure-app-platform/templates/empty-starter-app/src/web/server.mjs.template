  --bg:#fffdfb;--bg-soft:#f9f5f0;--bg-elev:#fffdfb;--surface-muted:#f1eae1;--border:#e4d9cc;--border-strong:#d0c0ae;
  --text:#231b15;--text-muted:#57483d;--accent:#c2410c;--accent-strong:#9a3412;--accent-soft:#ffedd5;
  --radius-md:10px;--radius-lg:14px;--radius-2xl:20px;
}
[data-style="modern"]{
  --bg-soft:#f4f7fb;--surface-muted:#eaeff7;--border:#d8e1ee;--border-strong:#cbd5e1;
  --text:#0f172a;--text-muted:#334155;--accent:#0f6cbd;--accent-strong:#115ea3;--accent-soft:#e6f2fb;
  --radius-md:6px;--radius-lg:10px;--radius-2xl:14px;
}
[data-style="editorial"]{
  --bg:#fdfbf7;--bg-soft:#f6f2ea;--bg-elev:#fdfbf7;--surface-muted:#efeae0;--border:#ded6c6;--border-strong:#cbbba0;
  --text:#1c1917;--text-muted:#44403c;--accent:#9a3412;--accent-strong:#7c2d12;--accent-soft:#ffedd5;
  --radius-md:4px;--radius-lg:6px;--radius-2xl:8px;--font-display:Georgia,Cambria,'Times New Roman',serif;
}
[data-style="minimal"]{
  --bg-soft:#f4f4f5;--surface-muted:#e4e4e7;--border:#18181b;--border-strong:#09090b;
  --text:#09090b;--text-muted:#27272a;--accent:#09090b;--accent-strong:#27272a;--accent-soft:#e4e4e7;
  --shadow-2:4px 4px 0 0 #18181b;--radius-md:2px;--radius-lg:4px;--radius-2xl:4px;--radius-pill:4px;
  --font-sans:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --font-display:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
