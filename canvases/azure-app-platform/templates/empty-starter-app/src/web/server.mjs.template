import { createServer } from "node:http";

const agentUrl = process.env.AGENT_URL || "http://127.0.0.1:8088";
const webPort = Number(process.env.WEB_PORT || 3000);
const appNameHtml = __APP_NAME_HTML_JSON__;
const purposeHtml = __PURPOSE_HTML_JSON__;
const page = `<!doctype html>
<html lang="en" data-style="copilot" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>${appNameHtml}</title><style>
:root,[data-style="copilot"]{
  --bg:#ffffff;--bg-soft:#faf9f8;--bg-elev:#ffffff;--surface-muted:#f3f2f0;--surface-sunken:#ebe9e5;
  --border:#e5e2dc;--border-strong:#d4d0c8;--text:#141418;--text-muted:#42434d;--text-soft:#686a78;
  --accent:#464feb;--accent-strong:#373fd9;--accent-soft:#eef0ff;--accent-contrast:#ffffff;
  --brand-gradient:linear-gradient(135deg,#464feb 0%,#47cffa 50%,#b47cf8 100%);
  --shadow-2:0 2px 6px rgba(20,20,24,0.05),0 8px 24px rgba(70,79,235,0.06);
  --radius-md:10px;--radius-lg:16px;--radius-2xl:24px;--radius-pill:999px;
  --font-sans:'Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;
  --font-display:'Segoe UI',-apple-system,BlinkMacSystemFont,sans-serif;
  --font-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
