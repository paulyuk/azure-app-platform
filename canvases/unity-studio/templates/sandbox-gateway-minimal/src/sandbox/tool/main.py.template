"""Generic ACA Sandbox tool boundary.

Illustrates the PII boundary from the Sandbox & Gateway pattern: this process
receives one JSON object on stdin, computes derived aggregates over any
numeric fields it finds, and returns only those aggregates — never the raw
input values — on stdout. Replace the computation with your own sandboxed
logic while keeping this input/output shape: one request in, one bounded,
non-identifying verdict out, then exit.
"""

from __future__ import annotations

import json
import sys
from typing import Any


def _numeric_values(payload: dict[str, Any]) -> list[float]:
    values: list[float] = []
    for value in payload.values():
        if isinstance(value, bool):
            continue
        if isinstance(value, (int, float)):
            values.append(float(value))
        elif isinstance(value, list):
            values.extend(float(item) for item in value if isinstance(item, (int, float)) and not isinstance(item, bool))
    return values


def summarize(payload: dict[str, Any]) -> dict[str, Any]:
    values = _numeric_values(payload)
    if not values:
        return {"count": 0, "sum": 0.0, "mean": 0.0, "min": 0.0, "max": 0.0}
    return {
        "count": len(values),
        "sum": round(sum(values), 4),
        "mean": round(sum(values) / len(values), 4),
        "min": round(min(values), 4),
        "max": round(max(values), 4),
    }


def main() -> int:
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict):
            raise ValueError("input must be a JSON object")
        verdict = summarize(payload)
    except (TypeError, ValueError, json.JSONDecodeError) as error:
        print(json.dumps({"error": str(error)}), file=sys.stderr)
        return 2

    print(json.dumps(verdict, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
