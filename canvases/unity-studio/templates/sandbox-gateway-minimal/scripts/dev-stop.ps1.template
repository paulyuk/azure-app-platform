param(
  [Parameter(ValueFromRemainingArguments = $true)]
  [string[]] $RuntimeArguments
)

$ErrorActionPreference = "SilentlyContinue"
foreach ($Argument in @($RuntimeArguments)) {
  switch ($Argument) {
    "--help" {
      Write-Host "Usage: .\scripts\dev-stop.ps1"
      exit 0
    }
    "-h" {
      Write-Host "Usage: .\scripts\dev-stop.ps1"
      exit 0
    }
    default {
      Write-Error "Unknown option: $Argument"
      exit 2
    }
  }
}

$Root = Split-Path -Parent $PSScriptRoot
$RunDir = Join-Path $Root ".dev-run"
$State = Join-Path $RunDir "processes.json"
if (Test-Path $State) {
  $items = Get-Content $State | ConvertFrom-Json
  foreach ($item in @($items)) {
    if (Get-Process -Id $item.pid -ErrorAction SilentlyContinue) {
      & taskkill.exe /PID $item.pid /T /F | Out-Null
    }
  }
}
Remove-Item -Recurse -Force $RunDir
Write-Host "__APP_NAME__ stopped."
