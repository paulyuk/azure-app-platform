# AI Gateway (OpenAI-compatible front door for models + MCP tools)
AZURE_AI_GATEWAY_ENDPOINT="https://<gateway-host-name>/"
AZURE_AI_GATEWAY_API_KEY="<gateway-api-key>"
AZURE_AI_GATEWAY_MODEL="gpt-latest"
AZURE_AI_GATEWAY_MINI_MODEL="gpt-mini-latest"

# Foundry Toolbox (tool registry the hosted agent uses)
TOOLBOX_ENDPOINT="https://<foundry-host-name>/api/projects/<project-name>/toolboxes/deal-finder-tools/versions/<version>/mcp?api-version=v1"
TOOLBOX_NAME="deal-finder-tools"

# Local-only demo rehearsal mode (Phase 6 offline path)
MOCK="0"
