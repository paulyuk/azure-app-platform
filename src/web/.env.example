# Set to 0 to call the real deal-finder agent instead of the built-in mock
# scenario generator. Requires the agent server running (see ../agent/README.md).
NEXT_PUBLIC_MOCK=1

# Base URL for the deal-finder agent server (ResponsesHostServer). Only used
# server-side (Next.js route handlers), never sent to the browser.
AGENT_URL=http://127.0.0.1:8088
