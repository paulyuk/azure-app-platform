# Default (leave NEXT_PUBLIC_MOCK unset): try the real deal-finder agent
# first, automatically fall back to the built-in mock scenario generator if
# it's not reachable. This means `npm run dev` alone works standalone, but
# also picks up a real agent with zero config if you start one
# (`cd src/agent && uv run main.py`) alongside it.
#
# Force one mode explicitly instead of auto-detecting:
#   NEXT_PUBLIC_MOCK=1   always use the mock scenario generator
#   NEXT_PUBLIC_MOCK=0   always call the real agent (errors surface, no fallback)
# NEXT_PUBLIC_MOCK=

# Base URL for the deal-finder agent server (ResponsesHostServer). Only used
# server-side (Next.js route handlers), never sent to the browser. Defaults
# to http://127.0.0.1:8088 if unset.
AGENT_URL=http://127.0.0.1:8088
# Maximum time for a live agent turn, including Hosted Skills/model calls.
AGENT_TIMEOUT_MS=120000
